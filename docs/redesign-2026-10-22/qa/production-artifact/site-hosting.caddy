@site_authenticated path /apresentacao /apresentacao/* /en/presentation /en/presentation/* /treinamento /treinamento/* /en/training /en/training/*
handle @site_authenticated {
  root * /srv
  rewrite * /spa.html
  file_server {
    disable_canonical_uris
  }
}
handle {
  root * /srv
  try_files {path}/index.html {path} =404
  file_server {
    disable_canonical_uris
    hide site-hosting.caddy _redirects _headers
  }
}
handle_errors 404 {
  root * /srv
  rewrite * /404.html
  header X-Robots-Tag "noindex, nofollow"
  file_server {
    status 404
    disable_canonical_uris
  }
}
