            "maxLength": 100
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "briefVersion": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "$ref": "./concept.schema.json"
          }
        },
        "required": [
