  "components": {
    "securitySchemes": {
      "siteSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "catalisa_site_session",
        "description": "Cookie opaco emitido pelo backend; seguro e HttpOnly. Validar sessão e origem."
      },
      "webhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Catalisa-Signature",
        "description": "Contrato de assinatura a pactuar com o emissor; validar timestamp, corpo e replay no servidor."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "retryable"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "briefVersion": {
            "type": "integer",
            "minimum": 0
          },
          "identityStatus": {
            "enum": [
              "anonymous",
              "provisional",
              "verified"
            ]
          },
          "leadStatus": {
            "enum": [
              "none",
              "pending",
              "created",
              "failed"
            ]
          }
        },
        "required": [
          "sessionRef",
          "briefVersion",
          "identityStatus",
          "leadStatus"
        ]
      },
      "MessageInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clientMessageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "step": {
            "enum": [
              "idea",
              "context",
              "goal",
              "refinement"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "briefVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "clientMessageId",
          "step",
          "text",
          "briefVersion"
        ]
      },
      "MessageReceipt": {
