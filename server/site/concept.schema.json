{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:catalisa:site:concept:1.0",
  "title": "Proposed concept response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "items": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "nextScreenId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 60
              }
            },
            "required": [
              "label",
              "nextScreenId"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "items",
          "action"
        ]
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "ai-engine",
              "analytics",
              "api-keys",
              "audit-trail",
              "baas",
              "banking",
              "banking-product-portfolio",
              "billing",
              "biometrics",
              "bureaus",
              "calculations-engine",
              "calendar",
              "cms",
              "commerce",
              "companies",
              "customers",
              "data-extraction",
              "data-store",
              "decision-engine",
              "decision-platform",
              "document-template",
              "e-signature",
              "email",
              "feature-flags",
              "file-storage",
              "iam",
              "meta-account",
              "open-finance",
              "payments",
              "people",
              "pricing-engine",
              "products",
              "rooms",
              "service-attestations",
              "slack",
              "sso",
              "webhooks-engine",
              "wpp",
              "wpp-business"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          }
        },
        "required": [
          "slug",
          "role"
        ]
      }
    },
    "journey": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 350
          },
          "blockSlugs": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "ai-engine",
                "analytics",
                "api-keys",
                "audit-trail",
                "baas",
                "banking",
                "banking-product-portfolio",
                "billing",
                "biometrics",
                "bureaus",
                "calculations-engine",
                "calendar",
                "cms",
                "commerce",
                "companies",
                "customers",
                "data-extraction",
                "data-store",
                "decision-engine",
                "decision-platform",
                "document-template",
                "e-signature",
                "email",
                "feature-flags",
                "file-storage",
                "iam",
                "meta-account",
                "open-finance",
                "payments",
                "people",
                "pricing-engine",
                "products",
                "rooms",
                "service-attestations",
                "slack",
                "sso",
                "webhooks-engine",
                "wpp",
                "wpp-business"
              ]
            }
          },
          "humanReview": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "blockSlugs",
          "humanReview"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "disclaimer": {
      "const": "Conceito exploratório. Não constitui proposta final, aprovação ou produto publicado."
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "summary",
    "hypothesis",
    "roles",
    "screens",
    "blocks",
    "journey",
    "limitations",
    "disclaimer"
  ]
}
