          "status",
          "requestId",
          "updatedAt"
        ]
      },
      "HandoffEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "handoffRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "queued",
              "delivered",
              "assigned",
              "failed"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "eventId",
          "handoffRef",
          "sequence",
          "status",
          "occurredAt"
        ]
      },
      "SessionSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "briefing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "idea": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "context": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "goal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": []
          },
          "messages": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "messageRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "role": {
                  "enum": [
                    "visitor",
                    "agent",
                    "system",
                    "human"
                  ]
                },
                "step": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "occurredAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "briefVersion": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "messageRef",
                "role",
                "step",
                "text",
                "occurredAt",
                "briefVersion"
              ]
            }
          },
          "availableChannels": {
            "type": "array",
            "items": {
              "enum": [
                "here",
                "email",
                "whatsapp"
              ]
