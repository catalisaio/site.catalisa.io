# Server only. Never prefix these variables with VITE_.
# Explicit backend: catalisa (verified staging Data Store) or supabase. SQLite is local only.
SITE_STORE=catalisa
SITE_STORE_COLLECTION=site_catalisa_sessions_v1
# Supabase is optional when SITE_STORE=catalisa; no fallback between backends.
SITE_SUPABASE_URL=https://your-staging-project.supabase.co
SITE_SUPABASE_SERVICE_ROLE_KEY=
SITE_SESSION_SECRET=
SITE_ALLOWED_ORIGINS=https://your-site-staging.example
# Optional SQLite development backend; never used in production.
SITE_LOCAL_DATABASE=.local/site/sessions.sqlite
# Dedicated site concept agent: authenticated owner must match; tools must be empty.
SITE_CATALISA_ORIGIN=https://panel-api.wpp.bb.stg.catalisa.app
SITE_CATALISA_TOKEN=
SITE_CATALISA_AGENT_ID=
SITE_CATALISA_OWNER_EMAIL=admin@catalisa.app
# Operational human conversation within the site, accepts email OR phone.
SITE_HANDOFF_BACKEND=site-inbox
SITE_INBOX_COLLECTION=site_catalisa_inbox_v1
SITE_HANDOFF_CHANNELS=here
# Optional alternate HTTP backend: requires a signed, idempotent receiver.
SITE_HANDOFF_URL=
SITE_HANDOFF_TOKEN=
SITE_HANDOFF_SIGNING_SECRET=
# Signature secret for delivery/assignment callbacks. Different from session secret.
SITE_WEBHOOK_SECRET=
