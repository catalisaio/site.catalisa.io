            "minLength": 1,
            "maxLength": 160
          },
          "briefVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "briefVersion"
        ]
      },
      "IdentityReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contactRef": {
            "type": "string",
