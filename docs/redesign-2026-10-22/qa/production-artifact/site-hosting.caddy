# Generated from site-build.json by scripts/generate-hosting.ts. Do not edit.
# Docs: https://caddyserver.com/docs/caddyfile/directives/map
map {query} {site_query_suffix} {
  "" ""
  ~^(.+)$ "?${1}"
}
@site_noindex path /spa.html /404.html /design-system /design-system/* /apresentacao /apresentacao/* /en/presentation /en/presentation/* /treinamento /treinamento/* /en/training /en/training/* /design-system/
header @site_noindex X-Robots-Tag "noindex, nofollow"
header /assets/* Cache-Control "public, max-age=31536000, immutable"
header /screenshots/* Cache-Control "public, max-age=2592000, must-revalidate"
header /videos/* Cache-Control "public, max-age=2592000, must-revalidate"
header /sitemap.xml Cache-Control "public, max-age=86400"
@site_alias_0 path /use-cases /use-cases/
redir @site_alias_0 /casos-de-uso{site_query_suffix} 301
